# Nhost GraphQL endpoint used by the site at runtime (public reads only, no secret needed here).
# Find it in the Nhost dashboard under Settings -> Environment Variables -> NHOST_GRAPHQL_URL.
NHOST_GRAPHQL_URL=https://xdyttnhegqcopywhsqtk.graphql.eu-central-1.nhost.run/v1

# Used locally to run `npm run db:setup` / `admin-schema-setup` / `admin-users-setup`,
# AND by the deployed app's /admin server actions (menu edits, photo uploads, publish) —
# must also be set in production (e.g. Vercel project env vars), not just .env.local.
# Never commit the real value. Put it in a local .env.local (already gitignored).
NHOST_ADMIN_SECRET=<the real secret from the Nhost dashboard>
NHOST_SUBDOMAIN=xdyttnhegqcopywhsqtk
NHOST_REGION=eu-central-1

# Comma-separated allow-list of emails permitted to sign in to /admin. This is the
# real enforcement mechanism regardless of the Nhost project's own sign-up setting.
ADMIN_ALLOWED_EMAILS=owner@example.com,dev@example.com
